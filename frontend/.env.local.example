# Written automatically by deploy/deploy.mjs after a successful factory
# deploy -- copy this file to .env.local and fill in manually if you deploy
# by hand instead.
NEXT_PUBLIC_REIN_FACTORY_ADDRESS=

# Optional -- get one free at https://cloud.reown.com if you want the
# WalletConnect QR flow. Browser-extension wallets (MetaMask, etc.) connect
# fine without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
