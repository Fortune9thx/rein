# Studio Next deploy account -- never commit the real .env file.
# "Studio Next" is genlayer-js's `studioDevnet` chain (id 61997) -- its real
# RPC is studio-dev.genlayer.com, not studio-next.genlayer.com (that
# hostname doesn't resolve; confirmed by reading genlayer-js@2.0.0-rc.1's
# own chain definitions).
STUDIO_NEXT_RPC_URL=https://studio-dev.genlayer.com/api
DEPLOYER_PRIVATE_KEY=

# Written by deploy/deploy.mjs after a successful deploy; read by the
# frontend as NEXT_PUBLIC_REIN_FACTORY_ADDRESS.
REIN_FACTORY_ADDRESS=
